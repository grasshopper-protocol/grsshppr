DATABASE_URL=postgresql://grasshopper:grasshopper@localhost:5432/grasshopper
BETTER_AUTH_SECRET=          # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional — email/password works without these)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend — required for email verification)
RESEND_API_KEY=

# Cron authentication (optional — protects /api cron endpoints)
CRON_SECRET=

# Google Calendar sync (optional — RFC-0012; off unless all four are set)
CALENDAR_SYNC_ENABLED=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_ENC_KEY=      # generate with: openssl rand -base64 32
# CALENDAR_TOKEN_ENC_KEY_PREVIOUS=   # only while rotating keys
# CALENDAR_SYNC_ALLOWED_USERS=       # comma-separated emails; unset = everyone
